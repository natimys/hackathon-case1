# Generate unique values before starting: openssl rand -hex 32
DB_HOST=db
DB_PORT=5432
DB_USER=app
DB_PASSWORD=replace-with-a-unique-database-password
DB_NAME=app
# Keep loopback by default. Set BACKEND_BIND_HOST=0.0.0.0 only when testing from a LAN device.
BACKEND_BIND_HOST=127.0.0.1
JWT_SECURITY_KEY=replace-with-at-least-32-random-characters
ACCESS_TOKEN_EXPIRES=15
REFRESH_TOKEN_EXPIRES=30
JWT_COOKIE_SECURE=false
JWT_COOKIE_SAMESITE=lax
DEBUG=false
ENVIRONMENT=development
TICKET_ATTACHMENT_MAX_BYTES=10485760
BILLING_DEMO_PAYMENTS_ENABLED=false
PAYMENTS_PROVIDER=yookassa
YOOKASSA_SHOP_ID=
YOOKASSA_SECRET_KEY=
YOOKASSA_API_BASE_URL=https://api.yookassa.ru/v3
YOOKASSA_RETURN_URL=https://example.org/payment/return
YOOKASSA_WEBHOOK_PATH=/api/webhooks/yookassa
# Set true only when the app is behind a trusted reverse proxy that overwrites X-Forwarded-For.
YOOKASSA_TRUST_PROXY_HEADERS=false
YOOKASSA_TRUSTED_PROXY_IPS=["127.0.0.1/32","::1/128"]
YOOKASSA_TRUSTED_IPS=["185.71.76.0/27","185.71.77.0/27","77.75.153.0/25","77.75.156.11/32","77.75.156.35/32","77.75.154.128/25","2a02:5180::/32"]
# Set only when fiscal receipts are enabled in the YooKassa shop. Uses the account email.
# Optional integer VAT code; only set with matching fiscalization details configured for the store.
# YOOKASSA_RECEIPT_VAT_CODE=1
EXPO_ACCESS_TOKEN=
NOTIFICATION_TIMEZONE_DEFAULT=Asia/Yakutsk
MEDIAMTX_API_URL=http://mediamtx:9997
MEDIAMTX_HLS_URL=http://localhost:8888
MEDIAMTX_BIND_HOST=127.0.0.1
# Generate a unique secret with at least 32 characters. Do not reuse JWT_SECURITY_KEY.
MEDIA_JWT_SECRET=replace-with-a-different-unique-media-secret
MEDIA_JWT_ISSUER=yakutsk-home
MEDIA_JWT_AUDIENCE=mediamtx
MEDIA_JWT_TTL_SECONDS=600
CORS_ORIGINS=[]
CORS_ALLOW_CREDENTIALS=true
CORS_ALLOW_METHODS=["GET","POST","PATCH","DELETE","OPTIONS"]
CORS_ALLOW_HEADERS=["Content-Type","X-CSRF-TOKEN"]
